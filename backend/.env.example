# Copy the existing NestJS backend .env into this backend directory.
# These are the SAME variable names; keep your existing values.
PORT=3000
NODE_ENV=development
# ENV is separate from NODE_ENV in the original cookie-domain logic.
ENV=development
CLIENT_URL=http://localhost:3001
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=Eventseasy
REDIS_URL=redis://127.0.0.1:6379
ACCESS_TOKEN_SECRET=replace-with-your-existing-access-secret
REFRESH_TOKEN_SECRET=replace-with-your-existing-refresh-secret
ACCESS_ISSUER=replace-with-your-existing-access-issuer
REFRESH_ISSUER=replace-with-your-existing-refresh-issuer
MAIL=replace-with-your-existing-sender-email
MAIL_PASS=replace-with-your-existing-gmail-app-password
MJ_APIKEY_PUBLIC=replace-with-your-existing-mailjet-public-key
MJ_APIKEY_PRIVATE=replace-with-your-existing-mailjet-private-key
KAFKA_CLIENT_ID=replace-with-your-existing-client-id
KAFKA_CLIENT_URL=localhost:9092
KAFKA_TOPIC_NAME=replace-with-your-existing-topic
KAFKA_TOPIC_PARTITIONS=3
KAFKA_CONSUMER_GROUP_ID=replace-with-your-existing-consumer-group
# Required for NODE_ENV=production: paste the actual multiline PEM values.
# Kafka's Java client expects the private key in PKCS#8 PEM format (BEGIN PRIVATE KEY).
KAFKA_CLIENT_CA_CERT=""
KAFKA_ACCESS_CERT=""
KAFKA_ACCESS_KEY=""
CRON_JOB_API_KEY=replace-with-your-existing-cron-key
# Cloudinary media (set either CLOUDINARY_URL or all three individual values below).
# Use a server-only API secret.
# CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# A dedicated secret is recommended. If blank, ACCESS_TOKEN_SECRET is used as a fallback.
MEDIA_DELIVERY_TOKEN_SECRET=replace-with-a-random-media-delivery-secret
# The backend proxy validates this signed token before it streams an authenticated Cloudinary asset.
MEDIA_DELIVERY_TOKEN_TTL_SECONDS=""
